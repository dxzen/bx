{
  "business": {
    "product": "食材损耗记录与复盘",
    "customer": "小型连锁餐饮企业",
    "user": "门店店长",
    "payer": "连锁总部",
    "channel": "区域餐饮协会引荐",
    "billing": "按连锁客户按月订阅",
    "currency": "CNY",
    "region": "上海",
    "period": "2027-01 至 2027-03（示例）",
    "months": 3
  },
  "assumptions": [
    {
      "key": "leads",
      "label": "每月独立触达的潜在客户",
      "unit": "客户/月",
      "source": "H1",
      "period": "2027-01 至 2027-03（示例）",
      "base": 10,
      "optimistic": 15,
      "conservative": 6
    },
    {
      "key": "conversion",
      "label": "触达后成为付费客户的比例",
      "unit": "比例",
      "source": "H1",
      "period": "2027-01 至 2027-03（示例）",
      "base": 0.2,
      "optimistic": 0.3,
      "conservative": 0.1
    },
    {
      "key": "onboarding_capacity",
      "label": "每月接入能力",
      "unit": "客户/月",
      "source": "H1",
      "period": "2027-01 至 2027-03（示例）",
      "base": 3,
      "optimistic": 4,
      "conservative": 2
    },
    {
      "key": "active_capacity",
      "label": "可同时服务的客户上限",
      "unit": "客户",
      "source": "H1",
      "period": "2027-01 至 2027-03（示例）",
      "base": 12,
      "optimistic": 15,
      "conservative": 6
    },
    {
      "key": "retention",
      "label": "上月活跃客户本月留存率",
      "unit": "比例",
      "source": "H2",
      "period": "2027-01 至 2027-03（示例）",
      "base": 0.9,
      "optimistic": 0.95,
      "conservative": 0.75
    },
    {
      "key": "price",
      "label": "含退款前的月订阅报价",
      "unit": "CNY/客户/月",
      "source": "H2",
      "period": "2027-01 至 2027-03（示例）",
      "base": 1200,
      "optimistic": 1500,
      "conservative": 900
    },
    {
      "key": "refund",
      "label": "按当月账单金额计的退款率",
      "unit": "比例",
      "source": "H2",
      "period": "2027-01 至 2027-03（示例）",
      "base": 0.02,
      "optimistic": 0.01,
      "conservative": 0.05
    },
    {
      "key": "share",
      "label": "按退款后收入计的平台分成率",
      "unit": "比例",
      "source": "H3",
      "period": "2027-01 至 2027-03（示例）",
      "base": 0.05,
      "optimistic": 0.04,
      "conservative": 0.08
    },
    {
      "key": "variable_cost",
      "label": "每活跃客户月履约支出",
      "unit": "CNY/客户/月",
      "source": "H3",
      "period": "2027-01 至 2027-03（示例）",
      "base": 300,
      "optimistic": 250,
      "conservative": 450
    },
    {
      "key": "cac",
      "label": "每新增客户获客支出",
      "unit": "CNY/新客户",
      "source": "H3",
      "period": "2027-01 至 2027-03（示例）",
      "base": 500,
      "optimistic": 350,
      "conservative": 700
    },
    {
      "key": "fixed",
      "label": "每月固定运营支出",
      "unit": "CNY/月",
      "source": "H3",
      "period": "2027-01 至 2027-03（示例）",
      "base": 2200,
      "optimistic": 2200,
      "conservative": 2600
    },
    {
      "key": "setup",
      "label": "期初一次性启动支出",
      "unit": "CNY",
      "source": "H3",
      "period": "2027-01 至 2027-03（示例）",
      "base": 2000,
      "optimistic": 1800,
      "conservative": 2500
    },
    {
      "key": "collection_lag",
      "label": "客户回款账期",
      "unit": "月",
      "source": "H4",
      "period": "2027-01 至 2027-03（示例）",
      "base": 1,
      "optimistic": 0,
      "conservative": 2
    },
    {
      "key": "payment_lag",
      "label": "履约费付款账期",
      "unit": "月",
      "source": "H4",
      "period": "2027-01 至 2027-03（示例）",
      "base": 0,
      "optimistic": 0,
      "conservative": 0
    }
  ],
  "formulas": [
    {
      "label": "容量与留存",
      "formula": "留存 = 上月活跃 × 留存率；漏斗新签 = min(触达 × 转化率，月接入上限)；实际新签 = min(漏斗新签，并行上限 − 留存)。"
    },
    {
      "label": "可得客户",
      "formula": "当月活跃 = 留存 + 实际新签。当期累计新签为各月实际新签之和。初始客户为零，小数客户为规划期望值。"
    },
    {
      "label": "收入与贡献",
      "formula": "净收入 = 活跃 × 月报价 × (1 − 退款率)；贡献 = 净收入 × (1 − 分成率) − 活跃 × 单位履约费。"
    },
    {
      "label": "期间经营结果",
      "formula": "各月贡献减去各月固定费和实际新签 × 获客成本后加总。一次性启动支出单列入现金流。"
    },
    {
      "label": "单月保本",
      "formula": "期末月所需活跃数 = (固定费 + 期末月获客支出) ÷ 单位贡献，向上取整；计算假定该月获客支出不变。"
    },
    {
      "label": "期末临界月价",
      "formula": "在期末月活跃量与新签量不变时，((固定费 + 该月获客支出) ÷ 活跃量 + 单位履约费) ÷ [(1 − 退款率) × (1 − 分成率)]，向上取分。"
    },
    {
      "label": "资金峰值",
      "formula": "月末累计现金从负启动支出起算；净收入扣分成后按回款账期收现；履约费按付款账期支付，固定费与获客费当月付。最低累计现金取负即峰值资金需求，含尾款结清。"
    }
  ],
